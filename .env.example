# Copy to `.env` and fill in. `.env` is gitignored; never commit real values.
#
# Credentials come from your Kaiwu account on the quantum cloud platform
# (https://platform.qboson.com/) under the SDK authorization page.
#
# These are only needed for hosted backends. The classical simulated annealer
# this experiment uses runs without them, so you can leave the file absent and
# still run everything in `examples/mnist_kaiwu`.
#
# Environment variables take precedence over this file, so a shell export wins.

KAIWU_USER_ID=
KAIWU_SDK_CODE=
